# Application Settings
ENVIRONMENT=development
DEBUG=false
APP_NAME=Transcript Chatbot

# LLM Settings
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
USE_STRUCTURED_OUTPUT=true

# Embedding Settings
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Vector Store Settings
# Options: in_memory, qdrant, pgvector
VECTOR_STORE_TYPE=in_memory

# Qdrant Settings (if using Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=transcripts

# PostgreSQL Settings (if using pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=transcripts_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Document Search Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SEARCH_K=5
SEARCH_SCORE_THRESHOLD=0.7

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["*"]
API_WORKERS=4

# Authentication Settings
JWT_SECRET_KEY=change-this-to-a-secure-random-key-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI API Key (REQUIRED)
OPENAI_API_KEY=your-openai-api-key-here

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/transcript_chatbot.log

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Storage Settings
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=10

# Observability (optional)
ENABLE_TRACING=false
OTEL_ENDPOINT=http://localhost:4318
